{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsd",
  "version": "0.1.0",
  "identifier": "dev.dsd.app",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "dsd",
        "url": "index.html",
        "width": 1480,
        "height": 920,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#111110"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Plans, docs, experiments and Claude Code sessions for data science",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../../build/pyinstaller/dsd/": "backend/dsd/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
